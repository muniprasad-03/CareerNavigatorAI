# backend/.env.example
# Purpose: Environment variables template for CareerNavigator AI
# Date: 2026-03-22

# Express port
PORT=5000

# Primary database connection string (MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/careernavigator

# Secret key for JWT signing
JWT_SECRET=your_jwt_secret_here

# Endpoint for the Cloud Fallback FastAPI AI Service
AI_ENDPOINT_URL=http://localhost:8000/match

# OpenAI API key (Optional: needed only for the FastAPI cloud fallback)
OPENAI_API_KEY=your_openai_key_here_optional

# Node runtime environment
NODE_ENV=development
